<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8"
    tools:context=".PetunjukActivityDikiReski">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="500dp"
            android:background="@drawable/bg_container_border"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="24dp">


            <TextView
                android:id="@+id/tvTitlePetunjuk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:text="PETUNJUK PENGGUNAAN"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvPetunjukContent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:lineSpacingExtra="10dp"
                android:text="1. Jalankan Aplikasi\n2. Pilih Icon Gaji Pegawai untuk menjalankan simulasi\n3. Pilih petunjuk penggunaan untuk cara penggunaan\n4. Pilih Tentang Aplikasi untuk informasi tentang aplikasi\n5. Pilih Exit untuk keluar aplikasi"
                android:textColor="#222222"
                android:textSize="15sp" />


            <Button
                android:id="@+id/btnKembaliPetunjuk"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_button_gray"
                android:text="Kembali"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</LinearLayout>